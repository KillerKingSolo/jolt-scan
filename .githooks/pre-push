#!/bin/sh
# runs tools/check.py; a pushed vX.Y.Z tag must match VERSION
tag=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/tags/v*) tag="${remote_ref#refs/tags/}" ;; esac
done
if [ -n "$tag" ]; then exec python tools/check.py --tag "$tag"; else exec python tools/check.py; fi
